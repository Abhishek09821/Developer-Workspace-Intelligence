# Copy to .env and adjust for your local environment.
# PYTHONPATH is set here to work around a Python bug where .pth files with
# spaces in the path are not processed. The src/ directory must be on the path.
PYTHONPATH=src

CANARY_ENVIRONMENT=development
CANARY_DEBUG=true

# Port 5433 is used to avoid clashing with a locally installed Postgres on 5432.
CANARY_DATABASE_URL=postgresql+asyncpg://canary:canary@localhost:5433/canary
CANARY_DATABASE_SYNC_URL=postgresql+psycopg://canary:canary@localhost:5433/canary

CANARY_REDIS_URL=redis://localhost:6379/0
CANARY_CELERY_BROKER_URL=redis://localhost:6379/1
CANARY_CELERY_RESULT_BACKEND=redis://localhost:6379/2

CANARY_JWT_SECRET_KEY=dev-secret-change-me
CANARY_JWT_ALGORITHM=HS256

CANARY_CORS_ALLOW_ORIGINS=["http://localhost:5173","http://localhost:3000"]

CANARY_AI_PROVIDER=none
CANARY_AI_API_KEY=

CANARY_GITHUB_CLIENT_ID=
CANARY_GITHUB_CLIENT_SECRET=

CANARY_LOG_LEVEL=INFO
CANARY_LOG_JSON=false
